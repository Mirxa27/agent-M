NODE_ENV=development

# Server
PORT=5000
HOST=0.0.0.0

# Database (if using individual params)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=mirxa

# Or use DATABASE_URL directly
DATABASE_URL=postgres://postgres:password@localhost:5432/mirxa

# Session & Security
SESSION_SECRET=replace-with-session-secret
ENCRYPTION_KEY=replace-with-encryption-key
SESSION_MAX_AGE=86400000

# AI Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=

# Public URL (used for OAuth callbacks)
BASE_URL=http://localhost:5000

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM=Example
